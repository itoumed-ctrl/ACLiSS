# Supabaseプロジェクトの接続情報（フェーズ1でSupabaseを作成後に設定）
# このファイルをコピーして .env.local を作成し、値を埋めてください。
# .env.local はGit管理対象外（.gitignoreに含まれる）です。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 管理画面のマスタ更新で使う書き込み権限キー。
# anonキーと違い、絶対に公開・共有しないこと。NEXT_PUBLIC_ を付けないことで
# ブラウザ側には送られず、サーバー側のコードからのみ参照される。
SUPABASE_SERVICE_ROLE_KEY=

# 管理画面（/admin）に入るための合言葉の初期値。
# 一度でも管理画面の「パスワードを変更」から変更すると、以降はDB側の値が優先され
# この環境変数は使われなくなる（管理画面から自由にパスワードを変更できるようにするため）。
ADMIN_PASSCODE=

# SupabaseのFreeプランの自動一時停止（7日間無アクセスで停止）を防ぐための
# 定期アクセス（/api/cron/keep-alive、vercel.jsonで1日1回起動）を守る合言葉。
# Vercelの環境変数に設定しておくと、Vercel Cronからのリクエストにだけ
# 自動的に付与されるため、第三者がこのエンドポイントを叩けなくなる。
# ローカル開発では未設定のままで問題ない（その場合は認証をスキップする）。
CRON_SECRET=
