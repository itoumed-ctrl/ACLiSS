# Supabaseプロジェクトの接続情報（フェーズ1でSupabaseを作成後に設定）
# このファイルをコピーして .env.local を作成し、値を埋めてください。
# .env.local はGit管理対象外（.gitignoreに含まれる）です。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 管理画面のマスタ更新で使う書き込み権限キー。
# anonキーと違い、絶対に公開・共有しないこと。NEXT_PUBLIC_ を付けないことで
# ブラウザ側には送られず、サーバー側のコードからのみ参照される。
SUPABASE_SERVICE_ROLE_KEY=

# 管理画面（/admin）に入るための合言葉。自由に変更してよい。
ADMIN_PASSCODE=

# サイト全体（看護師が使う画面）に入るためのBasic認証パスワード。
# ユーザー名は固定で "acliss"。この値が未設定の場合、サイトは全ページ500エラーになる
# （設定忘れで意図せず公開されるのを防ぐため）。
VIEWER_PASSCODE=
